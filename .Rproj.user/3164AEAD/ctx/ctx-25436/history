library(survival)
library(gamlss.cens)
set.seed(123)
## Generate survival times
true_time <- exp(y)
## Independent censoring
censor_time <- runif(
n,
0,
10
)
status <- as.numeric(
true_time <= censor_time
)
time <- pmin(
true_time,
censor_time
)
dados_cens <- data.frame(
time,
status,
x1,
x2
)
cat(
"Censoring proportion:",
round(mean(status == 0),3),
"\n"
)
gen.Family(
"LGG",
type="log"
)
gen.cens(
logLGG,
type="right"
)
fit_cens_tps <- gamlss(
Surv(time,status) ~
ga(~s(x1, bs="tp", m=2)+x2),
sigma.formula = ~1,
nu.formula = ~1,
family = logLGGrc(),
data = dados_cens,
trace = FALSE
)
summary(fit_cens_tps)
sigma_hat <- fitted(
fit_cens_tps,
"sigma"
)[1]
nu_hat <- fitted(
fit_cens_tps,
"nu"
)[1]
