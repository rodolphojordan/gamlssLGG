library(mgcv)
library(gamlss.add)
set.seed(123)
n <- 300
## Covariates
x1 <- runif(n, 0, 1)
x2 <- runif(n, -1, 1)
## True location function
f_true <- function(x1, x2){
2 + sin(2*pi*x1) + 1.5*x2
}
mu_true <- f_true(x1, x2)
## Remaining LGG parameters
sigma_true <- 0.7
nu_true <- 0.5
## Generate observations
y <- rLGG(
n,
mu = mu_true,
sigma = sigma_true,
nu = nu_true
)
dados <- data.frame(
y,
x1,
x2
)
tps.fit <- gamlss(
y ~ ga(~s(x1, bs = "tp", m = 2) + x2),
sigma.formula = ~1,
nu.formula = ~1,
data = dados,
family = LGG(),
trace = FALSE
)
summary(tps.fit)
newdata <- data.frame(
x1 = seq(0,1,length.out=200),
x2 = 0
)
mu_est <- predict(
tps.fit,
newdata = newdata,
what = "mu",
type = "response"
)
mu_true_plot <- f_true(
newdata$x1,
newdata$x2
)
plot(
newdata$x1,
mu_true_plot,
type="l",
lwd=3,
xlab="x1",
ylab=expression(mu),
main="Thin plate spline estimation"
)
lines(
newdata$x1,
mu_est,
col=2,
lwd=3
)
legend(
"topright",
legend=c(
"True function",
"Estimated function"
),
col=c(1,2),
lwd=3,
bty="n"
)
sigma_hat <- fitted(
tps.fit,
"sigma"
)[1]
nu_hat <- fitted(
tps.fit,
"nu"
)[1]
parameters <- data.frame(
Parameter = c("sigma", "nu"),
True = c(sigma_true, nu_true),
Estimate = c(sigma_hat, nu_hat)
)
parameters
